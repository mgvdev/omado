[Desktop Entry]
Type=Application
Name=Omado
GenericName=Tasks
Comment=Your tasks and reminders, in Omarchy
Exec=omado-gtk
Icon=dev.omado.Omado
Terminal=false
Categories=Office;ProjectManagement;GTK;
Keywords=todo;tasks;reminders;
StartupNotify=true
StartupWMClass=dev.omado.Omado
DBusActivatable=false
Actions=quick;

[Desktop Action quick]
Name=Quick entry
Exec=omado-gtk --quick
