#: crates/omado-cli/src/main.rs
msgid "Omado: your tasks, in Omarchy"
msgstr "Omado: le tue attività, in Omarchy"

#. Translators: quick entry understands English and French only: keep the example in English.
#: crates/omado-cli/src/main.rs
msgid ""
"Add a task, in quick entry syntax: “Call Paul tomorrow 9am #personal @phone !"
"1”"
msgstr ""
"Aggiunge un'attività con la sintassi dell'inserimento rapido: «Call Paul "
"tomorrow 9am #personal @phone !1»"

#: crates/omado-cli/src/main.rs
msgid "Destination list (otherwise #list in the text, or the inbox)"
msgstr ""
"Elenco di destinazione (altrimenti #elenco nel testo, oppure la posta in "
"arrivo)"

#: crates/omado-cli/src/main.rs
msgid "Show a view: today (default), upcoming, all, done, inbox, #list or @tag"
msgstr ""
"Mostra una vista: today (predefinita), upcoming, all, done, inbox, #elenco o "
"@etichetta"

#: crates/omado-cli/src/main.rs
msgid "Search titles and notes"
msgstr "Cerca nei titoli e nelle note"

#: crates/omado-cli/src/main.rs
msgid "Complete a task (the start of its ID is enough)"
msgstr "Completa un'attività (basta l'inizio del suo ID)"

#: crates/omado-cli/src/main.rs
msgid "Reopen a task"
msgstr "Riapre un'attività"

#: crates/omado-cli/src/main.rs
msgid "Delete a task"
msgstr "Elimina un'attività"

#: crates/omado-cli/src/main.rs
msgid "Show the lists"
msgstr "Mostra gli elenchi"

#: crates/omado-cli/src/main.rs
msgid "Show how an entry would be understood, without creating anything"
msgstr "Mostra come verrebbe interpretato un inserimento, senza creare nulla"

